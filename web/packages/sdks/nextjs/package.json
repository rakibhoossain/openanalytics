    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openanalytics/web": "workspace:*"
  },
  "peerDependencies": {
    "next": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@openpanel/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "tsup": "^7.2.0",
    "typescript": "catalog:"
  }
