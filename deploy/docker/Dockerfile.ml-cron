# ==============================================================================
# OpenAnalytics Automated ML Retraining Container
# Runs periodically in background to extract ClickHouse traffic, retrain models,
# export calibrated weights to /app/data/models, and signal Redis.
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

# Install ML requirements using pre-compiled binary wheels (avoids slow source compilation)
COPY ml/requirements.txt /app/ml/requirements.txt
RUN pip install --no-cache-dir --prefer-binary \
    -r /app/ml/requirements.txt \
    redis clickhouse-connect

# Copy source code
COPY ml /app/ml

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/ml

ENTRYPOINT ["python3", "/app/ml/cron_retrain.py"]
