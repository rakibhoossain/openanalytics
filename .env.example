# ==============================================================================
# OpenAnalytics Environment Configuration
# ==============================================================================

# Server Ports
INGEST_PORT=8080
QUERY_PORT=8081
METRICS_PORT=9090
ENV=development
LOG_LEVEL=info

# PostgreSQL (OLTP Metadata on Docker port 5435: Dashboards, Widgets, Saved Reports, Alerts)
DATABASE_URL=postgresql://openpanel:openpanel@localhost:5435/openpanel?sslmode=disable

# ClickHouse (OLAP Columnar Store on Docker port 9000 Native TCP: Events, Sessions, Customer Profiles)
CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_DATABASE=openpanel
CLICKHOUSE_USERNAME=openpanel
CLICKHOUSE_PASSWORD=openpanel
CLICKHOUSE_DEBUG=false

# Redis (Session State Buffer on Docker port 6380: Live Counters, Intent Cache)
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL_MINUTES=30

# Kafka Broker (Event Streaming Pipeline)
KAFKA_BROKERS=91.99.83.171:9092
KAFKA_EVENTS_TOPIC=analytics.events.raw
KAFKA_SESSIONS_TOPIC=analytics.sessions.boundary
KAFKA_CONSUMER_GROUP=openanalytics-worker-group
KAFKA_BATCH_SIZE=5000
KAFKA_BATCH_TIMEOUT_MS=1000

# GeoIP (Database files populated by geoipupdate docker container into data/geo)
GEOIP_DATA_DIR=data/geo

# Behavioral ML (Model artifacts stored in data/models)
ML_MODEL_PATH=data/models/cart_intent_v1.onnx
ML_INFERENCE_ENABLED=true
